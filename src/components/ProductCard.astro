---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { AVAILABILITY_LABEL, CATEGORY_LABEL } from '../utils';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { title, tagline, image, imageAlt, availability, category } = product.data;
const href = `/products/${product.id}/`;

const dotClass =
  availability === 'in-stock' ? 'blue' : availability === 'preorder' ? 'amber' : '';
---

<article class="card">
  <a href={href} class="hit">
    <div class="stage">
      {
        image ? (
          <Image
            src={image}
            alt={imageAlt ?? ''}
            widths={[320, 640]}
            sizes="(max-width: 640px) 92vw, 320px"
          />
        ) : (
          <span class="placeholder label-caps">{CATEGORY_LABEL[category]}</span>
        )
      }
    </div>

    <div class="body">
      <div>
        <h3>{title}</h3>
        <p class="tagline">{tagline}</p>
      </div>

      <div class="foot">
        <span class:list={['avail', availability]}>
          <span class:list={['dot', dotClass]}></span>
          {AVAILABILITY_LABEL[availability]}
        </span>
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface-lowest);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .card:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--surface-highest);
  }

  .hit { display: flex; flex-direction: column; height: 100%; }

  /* Image stage: a soft vertical wash so a cut-out product sits on a
     surface rather than floating on the card. */
  .stage {
    position: relative;
    aspect-ratio: 4 / 4.2;
    display: grid;
    place-items: center;
    padding: var(--space-lg);
    background: linear-gradient(to bottom, var(--surface-low), var(--surface-container));
    border-bottom: 1px solid var(--surface-container);
    overflow: hidden;
  }
  .stage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }
  .card:hover .stage :global(img) { transform: scale(1.04); }
  .placeholder { color: var(--outline); text-align: center; }

  .body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    padding: var(--space-lg);
  }
  h3 {
    margin-bottom: var(--space-sm);
    line-height: 1.35;
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card:hover h3 { color: var(--accent); }

  .tagline {
    margin: 0;
    font-size: 12px;
    line-height: 1.65;
    color: var(--on-surface-variant);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--surface-container);
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .avail.preorder { color: var(--signal-amber); }
  .avail.sold-out { color: var(--outline); }

  .arrow {
    color: var(--outline);
    font-size: 14px;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .card:hover .arrow { color: var(--on-surface); transform: translateX(4px); }
</style>
