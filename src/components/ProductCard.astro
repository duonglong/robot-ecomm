---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { AVAILABILITY_LABEL, parseSpec } from '../utils';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { title, tagline, image, imageAlt, availability, specs } = product.data;
const href = `/products/${product.id}/`;

// The reference cards carry one machined detail stamped over the image well.
// The first spec is the most characteristic thing about a part; show its value
// without the key, which would just repeat what the value already implies.
const stamp = specs.length > 0 ? parseSpec(specs[0]).value : undefined;

const dotClass =
  availability === 'in-stock' ? 'blue' : availability === 'preorder' ? 'amber' : '';
---

<article class="card">
  <a href={href} class="hit">
    <div class="well frame">
      {
        image ? (
          <Image
            src={image}
            alt={imageAlt ?? ''}
            widths={[320, 640]}
            sizes="(max-width: 640px) 45vw, 320px"
          />
        ) : (
          <span class="placeholder label-caps">{product.data.sku}</span>
        )
      }
      {stamp && <span class="stamp mono-spec-sm">{stamp}</span>}
    </div>

    <div class="body">
      <h3 class="headline-sm">{title}</h3>
      <p class="tagline body-sm muted">{tagline}</p>
      <div class="foot">
        <span class="status label-caps">
          <span class:list={['dot', dotClass]}></span>
          {AVAILABILITY_LABEL[availability]}
        </span>
        <span class="arrow mono-spec-sm" aria-hidden="true">&rarr;</span>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--surface-low);
    border-radius: var(--radius-lg);
    padding: var(--space-sm);
    border: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .card:hover { border-color: var(--outline-variant); }

  .hit { display: flex; flex-direction: column; height: 100%; }

  .frame {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    display: grid;
    place-items: center;
    margin-bottom: var(--space-sm);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Slow, decelerating scale — the reference easing, no bounce. */
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover .frame :global(img) { transform: scale(1.015); }

  .placeholder { color: var(--outline); }

  /* Chassis stamp: a spec fragment laid over the bottom edge of the well. */
  .stamp {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 100%;
    padding: var(--space-2xs) var(--space-sm);
    background: var(--surface-lowest);
    border-top-right-radius: var(--radius);
    color: var(--on-surface-variant);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-xs) var(--space-xs) var(--space-sm);
  }
  h3 {
    margin-bottom: var(--space-2xs);
    /* Long robot part names must not push cards to different heights. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tagline {
    margin: 0 0 var(--space-md);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  .arrow {
    color: var(--outline);
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .card:hover .arrow { color: var(--on-surface); transform: translateX(2px); }
</style>
