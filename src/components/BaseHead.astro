---
import { SITE_TITLE } from '../consts';
// Self-hosted variable fonts. Astro fingerprints and inlines the @font-face
// rules, so there is no render-blocking request to fonts.googleapis.com and
// the files inherit the immutable caching in public/_headers.
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative path to an OG image. */
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image = '/og-default.png', type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// Home page shouldn't read "Robotics Lab | Robotics Lab".
const fullTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#faf9f7" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonical} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} — Nhật ký chế tạo`}
  href={new URL('rss.xml', Astro.site)}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
