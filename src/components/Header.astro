---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';
import { NAV, SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} — trang chủ`}>
      <Image src={logoMark} alt="" class="mark" width={162} height={84} loading="eager" />
      <span class="wordmark">{SITE_TITLE}</span>
    </a>

    <nav aria-label="Điều hướng chính">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--surface-container);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .mark {
    height: 34px;
    width: auto;
    flex: none;
    display: block;
    transition: transform 0.2s ease;
  }
  .brand:hover .mark { transform: scale(1.05); }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--on-surface);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }
  .nav-link {
    position: relative;
    padding-block: var(--space-sm);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--outline);
    transition: color 0.2s ease;
  }
  .nav-link:hover { color: #1e293b; }
  .nav-link[aria-current='page'] {
    color: var(--on-surface);
    font-weight: 700;
  }
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--on-surface);
  }

  @media (max-width: 640px) {
    nav { gap: var(--space-md); }
    .mark { height: 30px; }
    .wordmark { font-size: 12px; letter-spacing: 0.16em; }
  }
  @media (max-width: 420px) {
    .wordmark {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }
</style>
