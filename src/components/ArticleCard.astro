---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils';

interface Props {
  entry: CollectionEntry<'posts'> | CollectionEntry<'guides'>;
  base: '/blog' | '/guides';
  showDate?: boolean;
}

const { entry, base, showDate = true } = Astro.props;
const { title, description, pubDate, tags, heroImage } = entry.data;

// Reading time drives the reference's "// 04 MIN READ" stamp. 200 wpm is the
// usual figure for technical prose.
const words = entry.body?.trim().split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 200));
---

<a href={`${base}/${entry.id}/`} class="row">
  <div class="text">
    <span class="meta mono-spec-sm dim">
      <span class:list={['dot', base === '/guides' ? 'dark' : 'blue']}></span>
      {showDate ? formatDate(pubDate) : (tags[0] ?? 'Hướng dẫn')}
      <span>// {minutes} phút đọc</span>
    </span>
    <h3 class="headline-sm">{title}</h3>
    <p class="body-sm muted">{description}</p>
  </div>
  {
    heroImage && (
      <div class="thumb well">
        <Image src={heroImage} alt="" widths={[160, 320]} sizes="120px" />
      </div>
    )
  }
</a>

<style>
  .row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--surface-low);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-sm);
    border: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .row:hover { border-color: var(--outline-variant); }
  .text { min-width: 0; }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }
  h3 {
    margin-bottom: var(--space-2xs);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  p {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .thumb {
    flex: none;
    width: 84px;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 640px) {
    .thumb { width: 120px; }
  }
</style>
