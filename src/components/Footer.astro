---
import { CONTACT_EMAIL, DISCORD_URL, GITHUB_URL, SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer>
  <div class="container">

    <div class="cols">
      <nav aria-label="Liên kết chân trang">
        <a href="/" class="mono-spec-sm">Sản phẩm</a>
        <a href="/guides/" class="mono-spec-sm">Hướng dẫn</a>
        <a href="/blog/" class="mono-spec-sm">Nhật ký</a>
        <a href="/rss.xml" class="mono-spec-sm">RSS</a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="mono-spec-sm">Liên hệ</a>
        {DISCORD_URL && <a href={DISCORD_URL} class="mono-spec-sm">Discord</a>}
        {GITHUB_URL && <a href={GITHUB_URL} class="mono-spec-sm">GitHub</a>}
      </nav>
    </div>

    <p class="label-caps colophon">
      {SITE_TITLE} © {year} — Dựng bằng Astro, phân phối qua Cloudflare
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-4xl);
    padding-block: var(--space-lg) var(--space-xl);
    border-top: 1px solid var(--outline-variant);
    background: var(--surface-low);
  }
  .cols {
    margin-bottom: var(--space-lg);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    align-content: start;
  }
  nav a {
    color: var(--on-surface-variant);
    text-transform: uppercase;
    transition: color 0.15s ease;
  }
  nav a:hover { color: var(--on-surface); }
  .colophon {
    margin: 0;
    color: var(--outline);
  }
</style>
